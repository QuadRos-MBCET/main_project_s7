# System Secret Key
SECRET_KEY=safead_ai_jwt_secret_key_change_in_production_2026

# Database Connection (Default: SQLite local/Colab; Set MySQL URL for production)
# Example MySQL: mysql+pymysql://root:password@localhost:3306/safead_db
DATABASE_URL=sqlite:///./safead.db

# Optional Remote Colab API URL (e.g. ngrok or Colab public endpoint)
COLAB_API_URL=

# Streamlit Backend Connection
BACKEND_URL=http://127.0.0.1:8000/api/v1
