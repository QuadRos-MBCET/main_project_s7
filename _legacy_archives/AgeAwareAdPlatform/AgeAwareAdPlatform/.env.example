# Age-Aware Advertisement Platform Configuration
# Copy this file to .env and adjust variables as required

PROJECT_NAME="Age-Aware Advertisement Platform"
API_V1_STR="/api/v1"

# Authentication & Security
AUTH_SECRET="your-secure-jwt-secret-key-change-in-production-2026"
SECRET_KEY="your-secure-jwt-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (SQLite default, or MySQL: mysql+pymysql://user:pass@localhost:3306/safead)
DATABASE_URL="sqlite:///./backend/safead.db"

# Service URLs
BACKEND_URL="http://127.0.0.1:8000"
FACE_AGE_SERVICE_URL="http://127.0.0.1:8000/api/v1/age"

# Optional Remote AI GPU Acceleration Server (Google Colab / Cloudflare tunnel)
COLAB_API_URL=""

# Network Configuration
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=8501
